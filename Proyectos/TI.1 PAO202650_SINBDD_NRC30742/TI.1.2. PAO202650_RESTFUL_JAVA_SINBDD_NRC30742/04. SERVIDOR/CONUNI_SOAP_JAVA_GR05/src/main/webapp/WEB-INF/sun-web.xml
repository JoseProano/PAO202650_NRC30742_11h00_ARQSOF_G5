<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sun-web-app PUBLIC "-//Sun Microsystems, Inc.//DTD GlassFish Application Server 3.1 Servlet 3.0//EN" "http://www.sun.com/software/appserver/dtds/sun-web-app_3_0-1.dtd">
<sun-web-app>
    <!-- 
        Context Root: Define la ruta base de la aplicación
        Si se deja vacío o se omite, se usará el nombre del WAR sin extensión
        Ejemplo: /conversion o /CONUNI_SOAP_JAVA_GR09-1.0-SNAPSHOT
    -->
    <context-root>/conversion</context-root>
    
    <!-- 
        Virtual Server: Define el servidor virtual de Payara
        Por defecto es "server", pero puedes cambiarlo si tienes múltiples virtual servers
    -->
    <virtual-server>server</virtual-server>
    
    <!-- 
        Configuración adicional para mejorar la accesibilidad desde otras computadoras
    -->
    <property name="keepgenerated" value="true"/>
</sun-web-app>


